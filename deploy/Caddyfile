# TLS, access control and the proxy to the game server. Caddy gets and renews the HTTPS
# certificate for the domain by itself; the domain's DNS must already point at this machine.
{$DEANHACK_DOMAIN:deanhack.online} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Link previews (iMessage, Slack, Discord, X, WhatsApp...): the bots that build the preview card
	# cannot type a password, so they get a bare page with only the title, description and banner.
	# Nothing of the game is on it, and the banner image below is the only other public file.
	@preview header_regexp ua User-Agent (?i)(facebookexternalhit|twitterbot|slackbot|discordbot|whatsapp|telegrambot|linkedinbot|applebot|skypeuripreview)
	handle @preview {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html><html lang="en"><head><meta charset="utf-8"><title>DeanHack</title>
			<meta name="description" content="An UnNetHack fork.">
			<meta property="og:type" content="website"><meta property="og:site_name" content="DeanHack">
			<meta property="og:title" content="DeanHack"><meta property="og:description" content="An UnNetHack fork.">
			<meta property="og:url" content="https://{$DEANHACK_DOMAIN:deanhack.online}/">
			<meta property="og:image" content="https://{$DEANHACK_DOMAIN:deanhack.online}/og.png">
			<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
			<meta name="twitter:card" content="summary_large_image"><meta name="theme-color" content="#070d10">
			</head><body>DeanHack</body></html>
			HTML 200
	}

	handle /og.png {
		reverse_proxy app:8080 {
			header_up -X-Player-Id
		}
	}

	# Everything else needs a login. Each friend has their own (see deploy/users/README.md), and the
	# game gives every login its own engine and saves: the server learns who is playing from
	# X-Player-Id, which is set here from the login and replaces anything the browser sent.
	handle {
		basic_auth {
			{$DEANHACK_USER:dean} {$DEANHACK_PASSWORD_HASH}
			import /etc/caddy/users/*.caddy
		}
		# flush_interval -1 sends the /engine/events stream straight through instead of buffering it.
		reverse_proxy app:8080 {
			flush_interval -1
			header_up X-Player-Id {http.auth.user.id}
		}
	}
}
